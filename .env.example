# Public Supabase URL and anon/publishable key; never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Optional; without this, chat and study tools use explicitly labeled local answers.
# Free credits via MLH; create the key in Google AI Studio.
GEMINI_API_KEY=
# Allow paid AI without sign-in ONLY on loopback during local development.
ALLOW_LOCAL_AI=false

# Optional chatbot provider. Study tools and PDF syllabus scans keep using Gemini.
AI_CHAT_PROVIDER=gemini
# For DigitalOcean: set AI_CHAT_PROVIDER=digitalocean and both values below.
# Server-only inference model access key (not an account-wide API token).
DIGITALOCEAN_MODEL_ACCESS_KEY=
DIGITALOCEAN_MODEL=
