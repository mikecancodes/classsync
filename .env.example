# Public Supabase URL and anon/publishable key; never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Optional; without this, AI uses explicitly labeled local study tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Allow paid AI without sign-in ONLY on loopback during local development.
ALLOW_LOCAL_AI=false
