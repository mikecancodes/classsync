# Public Supabase URL and anon/publishable key; never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Optional; without this, chat, study tools and syllabus scans use labeled local answers.
# DigitalOcean serverless inference model access key (inference-scoped, not an account token).
# Setup and cost limits: docs/md/digitalocean-ai.md
DIGITALOCEAN_MODEL_ACCESS_KEY=
# Optional: DigitalOcean model ID with tool calling (default glm-5.3-flash).
DIGITALOCEAN_MODEL=
# Optional: OpenAI-compatible endpoint override (default https://inference.do-ai.run/v1).
AI_BASE_URL=
# Allow paid AI without sign-in ONLY on loopback during local development.
ALLOW_LOCAL_AI=false
