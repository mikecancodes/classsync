{
  "manifest_version": 3,
  "name": "ClassSync D2L Sync",
  "version": "0.1.0",
  "description": "Reads your D2L (Brightspace) courses, due dates and announcements and sends them to ClassSync for review.",
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ClassSync" },
  "options_page": "options.html",
  "permissions": ["storage", "alarms", "scripting", "tabs"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
}
